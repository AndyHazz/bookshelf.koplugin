msgstr "Звезда"

#: lib/bookshelf_settings.lua:1063
msgid "Favorite icon"
msgstr "Икона за любими"

#: lib/bookshelf_settings.lua:1100
msgid "Folders only"
msgstr "Само папки"

#: lib/bookshelf_settings.lua:1101
msgid "Groups only"
msgstr "Само групи"

#: lib/bookshelf_settings.lua:1102
msgid "All stacks"
msgstr "Всички стекове"

#: lib/bookshelf_settings.lua:1117
