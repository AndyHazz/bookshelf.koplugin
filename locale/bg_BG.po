#: lib/bookshelf_settings.lua:826
msgid "A line of text under stacks and folders, chosen apart from the books' text. Author shows a series' author. Folder title styles that print the name below the tile keep that line for the name."
msgstr "Ред текст под стековете и папките, избиран отделно от текста на книгите. Автор показва автора на поредицата. Стиловете на папките, които изписват името под плочката, запазват този ред за името."

#: lib/bookshelf_settings.lua:839
msgid "True cover aspect ratio"
msgstr "Истинско съотношение на корицата"

#: lib/bookshelf_settings.lua:840
msgid "Show each cover at its real shape instead of a uniform book rectangle. Covers keep the same width but vary in height: on the shelf they sit along the bottom shelf line, and in the top panel they align to the top. Wide or square covers stop being cropped or stretched. Off by default (uniform grid)."
msgstr "Показва всяка корица в истинската ѝ форма вместо като еднакъв правоъгълник. Кориците запазват една и съща ширина, но се различават по височина: на рафта стъпват на долната линия на рафта, а в горния панел се подравняват отгоре. Широките и квадратните корици вече не се изрязват и не се разтягат. По подразбиране е изключено (еднаква мрежа)."

#: lib/bookshelf_settings.lua:870
msgid "(default)"
msgstr "(по подразбиране)"

#: lib/bookshelf_settings.lua:891
msgid "Tallest cover shape"
msgstr "Най-голяма височина на корица"

#: lib/bookshelf_settings.lua:894
msgid "How tall a cover may be, relative to its width, before the extra height is trimmed. Taller values show more of an unusually tall cover; they also make every row taller, so fewer rows fit on the shelf. Only applies with True cover aspect ratio on."
msgstr "Каква височина може да има една корица спрямо ширината си, преди излишната височина да бъде отрязана. По-високите стойности показват повече от необичайно висока корица, но правят и всеки ред по-висок, така че на рафта се събират по-малко редове. Прилага се само при включени истински пропорции на кориците."

#: lib/bookshelf_settings.lua:907
msgid "Square cover corners"
msgstr "Правоъгълни ъгли на кориците"

#: lib/bookshelf_settings.lua:908
msgid "Draw covers with square corners instead of the rounded card shape. Independent of the drop shadow, so a flatter look can keep the shadow or drop it separately. Off by default (rounded)."
msgstr "Показва кориците с правоъгълни вместо със заоблени ъгли. Не зависи от сянката, така че по-плоският вид може да запази сянката или да я премахне отделно. По подразбиране е изключено (заоблени)."

#: lib/bookshelf_settings.lua:924
msgid "No cover drop shadow"
msgstr "Без сянка на кориците"

#: lib/bookshelf_settings.lua:925
msgid "Draw covers flat against the page instead of raised off it. The pixels the shadow reserved go back to the cover, so covers get slightly larger. Off by default (shadow shown)."
msgstr "Показва кориците плоско върху страницата, вместо повдигнати. Пикселите, запазени за сянката, се връщат на корицата, така че кориците стават малко по-големи. По подразбиране е изключено (сянката се показва)."

#: lib/bookshelf_settings.lua:955
msgid "Default folder style: "
msgstr "Стил на папките по подразбиране: "

#: lib/bookshelf_settings.lua:957
msgid "How folders and stacks are drawn on any shelf that has not chosen its own. Long-press a shelf to override it there."
msgstr "Как се изчертават папките и стековете на всеки рафт, който не е избрал собствен стил. Задръжте върху рафт, за да зададете друг стил там."

#: lib/bookshelf_settings.lua:967
msgid "Show progress bars"
msgstr "Показване на ленти за прогрес"

#: lib/bookshelf_settings.lua:969
msgid "Show reading bookmarks"
msgstr "Показване на отметки за четене"

#: lib/bookshelf_settings.lua:973
msgid "Show page count"
msgstr "Показване на брой страници"

#: lib/bookshelf_settings.lua:1001
msgid "Bookmark style"
msgstr "Като отметка"

#: lib/bookshelf_settings.lua:1002
msgid "Small tick box"
msgstr "Малко квадратче"

#: lib/bookshelf_settings.lua:1017
msgid "Completed book badge"
msgstr "Значка за завършена книга"

#: lib/bookshelf_settings.lua:1031
msgid "Fade finished books"
msgstr "Избледняване на завършените книги"

#: lib/bookshelf_settings.lua:1060
msgid "Pause badge"
msgstr "Значка за пауза"

#: lib/bookshelf_settings.lua:1061
msgid "Faded cover"
msgstr "Избледняла корица"

#: lib/bookshelf_settings.lua:1062 micromodules/quote_of_day.lua:106
#: micromodules/quote_of_day.lua:193
msgid "Both"
msgstr "И двете"

#: lib/bookshelf_settings.lua:1067
msgid "Pause badge + faded cover"
msgstr "Значка за пауза + избледняла корица"

#: lib/bookshelf_settings.lua:1082
msgid "On-hold display"
msgstr "Изглед на изчакващите книги"

#: lib/bookshelf_settings.lua:1118
msgid "Within series folder"
msgstr "В папка на поредица"

#: lib/bookshelf_settings.lua:1119
msgid "Never"
msgstr "Никога"

#: lib/bookshelf_settings.lua:1134
msgid "Show series #"
msgstr "Показване на № в поредица"

#: lib/bookshelf_settings.lua:1152
msgid "Show favorites icon"
msgstr "Показване на иконата за любими"

#: lib/bookshelf_settings.lua:1167
msgid "Star"
msgstr "Звезда"

#: lib/bookshelf_settings.lua:1181
msgid "Favorite icon"
msgstr "Икона за любими"

#: lib/bookshelf_settings.lua:1217 lib/bookshelf_settings.lua:3099
#: lib/bookshelf_settings.lua:3932 lib/bookshelf_settings.lua:3959
#: lib/bookshelf_settings.lua:5239
msgid "Off"
msgstr "Изкл."

#: lib/bookshelf_settings.lua:1218
msgid "Folders only"
msgstr "Само папки"

#: lib/bookshelf_settings.lua:1219
msgid "Groups only"
msgstr "Само групи"

#: lib/bookshelf_settings.lua:1220
msgid "All stacks"
msgstr "Всички стекове"

#: lib/bookshelf_settings.lua:1235
msgid "Stack count badge"
msgstr "Значка с брой в стека"

#: lib/bookshelf_settings.lua:1266
msgid "Total"
msgstr "Общо"

#: lib/bookshelf_settings.lua:1267
msgid "Finished / Total"
msgstr "Завършени / Общо"

#: lib/bookshelf_settings.lua:1282
msgid "Stack count format"
msgstr "Формат на брояча в стека"

#: lib/bookshelf_settings.lua:1297
msgid "Cover opening effect"
msgstr "Ефект при отваряне на корицата"

#: lib/bookshelf_settings.lua:1298
msgid "When you open a book, briefly flex its cover open before the page appears. Purely cosmetic; turn it off for an instant, plain open. On by default."
msgstr "Когато отворите книга, за кратко корицата ѝ се отгръща, преди да се появи страницата. Чисто козметично; изключете го за мигновено, обикновено отваряне. По подразбиране е включено."

#: lib/bookshelf_settings.lua:1386
msgid "Rows, columns and view are set per shelf:"
msgstr "Редовете, колоните и изгледът се задават за всеки рафт:"

#: lib/bookshelf_settings.lua:1390
msgid "long-press a shelf, then open Shelf style."
msgstr "Задръжте върху рафт и отворете Стил на рафта."

#: lib/bookshelf_settings.lua:1417
msgid "Add a line (maximum reached)"
msgstr "Добавяне на ред (достигнат максимум)"

#: lib/bookshelf_settings.lua:1419
msgid "Add a line"
msgstr "Добавяне на ред"

#: lib/bookshelf_settings.lua:1520
msgid "Move up"
msgstr "Преместване нагоре"

#: lib/bookshelf_settings.lua:1523
msgid "Move down"
msgstr "Преместване надолу"

