msgid "\"Latest\" folder walk depth"
msgstr "Such-Tiefe für „Neueste“"

#: lib/bookshelf_settings.lua:4664
msgid "How deep to scan your library folder for newly-added books. Higher values take longer on a cold start."
msgstr "Wie tief Ihr Bibliotheks-Ordner nach neu hinzugefügten Büchern durchsucht wird. Höhere Werte verlangsamen den Kaltstart."

#: lib/bookshelf_settings.lua:4680
msgid "MB"
