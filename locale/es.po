msgstr "Estrella (favorito)"

#: lib/bookshelf_settings.lua:1269
msgid "Stars (rating)"
msgstr "Estrellas (valoración)"

#: lib/bookshelf_settings.lua:1283
msgid "Favorite icon or star rating: %1"
msgstr "Icono de favorito o valoración con estrellas: %1"

#: lib/bookshelf_settings.lua:1321
msgid "Folders only"
msgstr "Solo carpetas"

#: lib/bookshelf_settings.lua:1322
msgid "Groups only"
msgstr "Solo grupos"

#: lib/bookshelf_settings.lua:1323
msgid "All stacks"
msgstr "Todas las pilas"

#: lib/bookshelf_settings.lua:1338
msgid "Stack count badge"
msgstr "Insignia de recuento de pila"

#: lib/bookshelf_settings.lua:1369
msgid "Total"
msgstr "Total"

#: lib/bookshelf_settings.lua:1370
