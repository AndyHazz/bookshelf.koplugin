msgstr "Dans le panneau supérieur"

#: lib/bookshelf_settings.lua:2718
msgid "Full-screen button"
msgstr "Bouton plein écran"

#: lib/bookshelf_settings.lua:2723 lib/bookshelf_settings.lua:5059
#: lib/bookshelf_settings.lua:5485
msgid "Start menu"
msgstr "Menu de démarrage"

#: lib/bookshelf_settings.lua:2732
msgid "Behavior"
msgstr "Comportement"

#: lib/bookshelf_settings.lua:2738
msgid "Library & search"
msgstr "Bibliothèque et recherche"

#: lib/bookshelf_settings.lua:2744
