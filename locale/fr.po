msgstr "Côté : droite"

#: lib/bookshelf_settings.lua:3754
msgid "Edge: bottom"
msgstr "Bord : bas"

#: lib/bookshelf_settings.lua:3754
msgid "Edge: top"
msgstr "Bord : haut"

#: lib/bookshelf_settings.lua:3840
msgid "Minimum start menu width"
msgstr "Largeur minimale du menu de démarrage"

#: lib/bookshelf_settings.lua:3930
msgid "Modal tab label font scale"
msgstr "Échelle de police des onglets de la fenêtre"

#: lib/bookshelf_settings.lua:4004
msgid "Hero card"
msgstr "Carte vedette"

#: lib/bookshelf_settings.lua:4005
msgid "Hero micro-modules"
msgstr "Micro-modules vedettes"

#: lib/bookshelf_settings.lua:4006
msgid "Chip bar"
msgstr "Barre d'onglets"

#: lib/bookshelf_settings.lua:4007
msgid "Stack & folder labels"
msgstr "Libellés de piles et dossiers"

#: lib/bookshelf_settings.lua:4008
msgid "Expanded shelf labels"
msgstr "Libellés de l'étagère développée"

#: lib/bookshelf_settings.lua:4009
msgid "Cover badges"
msgstr "Badges de couverture"

#: lib/bookshelf_settings.lua:4011
msgid "Modal tabs"
msgstr "Onglets de la fenêtre"

#: lib/bookshelf_settings.lua:4028
msgid "Choose image library folder"
msgstr "Choisir le dossier de la bibliothèque d'images"

#: lib/bookshelf_settings.lua:4054
msgid "\"Latest\" folder walk depth"
msgstr "Profondeur d'exploration du dossier « Récents »"

#: lib/bookshelf_settings.lua:4055
msgid "How deep to scan your library folder for newly-added books. Higher values take longer on a cold start."
msgstr "Profondeur d'analyse du dossier de bibliothèque pour les livres récemment ajoutés. Des valeurs plus élevées ralentissent le démarrage à froid."

#: lib/bookshelf_settings.lua:4071
msgid "MB"
msgstr "Mo"

#: lib/bookshelf_settings.lua:4072
msgid "Cover cache budget"
msgstr "Budget du cache des couvertures"

#: lib/bookshelf_settings.lua:4073
msgid "Memory budget for ready-scaled book covers (MB). Higher = smoother paging and preloading, more RAM. Default 24 MB."
msgstr "Budget mémoire pour les couvertures de livres mises à l'échelle (Mo). Plus élevé = pagination et préchargement plus fluides, plus de RAM. 24 Mo par défaut."

#: lib/bookshelf_settings.lua:4207
msgid "Link copied to clipboard"
msgstr "Lien copié dans le presse-papiers"

#: lib/bookshelf_settings.lua:4283
msgid "Notify on wake when update available"
msgstr "Notifier au réveil si une mise à jour est disponible"

#: lib/bookshelf_settings.lua:4302
msgid "Update available"
msgstr "Mise à jour disponible"

#: lib/bookshelf_settings.lua:4305
msgid "Installed version"
msgstr "Version installée"

#: lib/bookshelf_settings.lua:4311
msgid "Developer updates"
msgstr "Mises à jour développeur"

#: lib/bookshelf_settings.lua:4316 lib/bookshelf_settings.lua:4317
#: main.lua:1879
msgid "Development branch"
msgstr "Branche de développement"

#: lib/bookshelf_settings.lua:4327
msgid "Check for updates"
msgstr "Rechercher des mises à jour"

#: lib/bookshelf_settings.lua:4328
msgid "Install branch"
msgstr "Installer la branche"

#: lib/bookshelf_settings.lua:4334
msgid "Reset to latest stable release"
msgstr "Réinitialiser à la dernière version stable"

#: lib/bookshelf_settings.lua:4345 lib/bookshelf_settings.lua:4348
msgid "Installed: v"
msgstr "Installé : v"

#: lib/bookshelf_settings.lua:4388
msgid "Flexible chip widths"
msgstr "Largeurs de puce flexibles"

#: lib/bookshelf_settings.lua:4389
msgid "Off: every chip gets the same width. On: each chip is sized to its label, so single-icon chips stay narrow and longer text labels get more room. Falls back to equal widths when natural sizes don't fit."
msgstr "Désactivé : tous les onglets ont la même largeur. Activé : chaque onglet est dimensionné selon son libellé, les onglets à icône unique restent donc étroits et les libellés plus longs ont plus d'espace. Revient à des largeurs égales lorsque les tailles naturelles ne tiennent pas."

#: lib/bookshelf_settings.lua:4449
msgid "+ Add new chip"
msgstr "+ Ajouter une puce"

#: lib/bookshelf_sort_engine.lua:351
msgid "Filename"
msgstr "Nom de fichier"

#: lib/bookshelf_sort_engine.lua:355
msgid "Author (given name)"
msgstr "Auteur (prénom)"

