msgstr "Abas do modal"

#: lib/bookshelf_settings.lua:4028
msgid "Choose image library folder"
msgstr "Escolher pasta da biblioteca de imagens"

#: lib/bookshelf_settings.lua:4054
msgid "\"Latest\" folder walk depth"
msgstr "Profundidade de varredura da pasta \"Mais recentes\""

#: lib/bookshelf_settings.lua:4055
msgid "How deep to scan your library folder for newly-added books. Higher values take longer on a cold start."
msgstr "Quão fundo escanear sua pasta da biblioteca por livros recém-adicionados. Valores maiores demoram mais na primeira inicialização."

#: lib/bookshelf_settings.lua:4071
msgid "MB"
msgstr "MB"

#: lib/bookshelf_settings.lua:4072
msgid "Cover cache budget"
msgstr "Limite do cache de capas"

#: lib/bookshelf_settings.lua:4073
msgid "Memory budget for ready-scaled book covers (MB). Higher = smoother paging and preloading, more RAM. Default 24 MB."
msgstr "Limite de memória para capas de livros já redimensionadas (MB). Maior = paginação e pré-carregamento mais suaves, mais RAM. Padrão 24 MB."

#: lib/bookshelf_settings.lua:4207
msgid "Link copied to clipboard"
msgstr "Link copiado para a área de transferência"

#: lib/bookshelf_settings.lua:4283
msgid "Notify on wake when update available"
msgstr "Notificar ao despertar quando houver atualização"

#: lib/bookshelf_settings.lua:4302
