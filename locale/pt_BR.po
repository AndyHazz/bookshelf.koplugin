msgstr "Fundo do selo (% preto)"

#: lib/bookshelf_settings.lua:2693 lib/bookshelf_settings.lua:2701
msgid "Micro-module background"
msgstr "Fundo dos micro-módulos"

#: lib/bookshelf_settings.lua:2695
msgid "The card behind each micro-module. Kept solid: the text inside a module draws its own opaque background, so a see-through card shows a box behind every line."
msgstr "O cartão atrás de cada micro-módulo. Mantido sólido: o texto dentro de um módulo desenha seu próprio fundo opaco, então um cartão transparente mostra uma caixa atrás de cada linha."

#: lib/bookshelf_settings.lua:2701
msgid "Micro-module background (% black)"
msgstr "Fundo dos micro-módulos (% preto)"

#: lib/bookshelf_settings.lua:2711 lib/bookshelf_settings.lua:2718
msgid "Micro-module border"
msgstr "Borda dos micro-módulos"

#: lib/bookshelf_settings.lua:2713
msgid "The thin line around each micro-module card. Left unset it follows the text color. Long-press to clear."
msgstr "A linha fina ao redor de cada cartão de micro-módulo. Se não for definida, segue a cor do texto. Mantenha pressionado para limpar."

#: lib/bookshelf_settings.lua:2718
msgid "Micro-module border (% black)"
msgstr "Borda dos micro-módulos (% preto)"

#: lib/bookshelf_settings.lua:2729 lib/bookshelf_settings.lua:2736
msgid "Border color"
msgstr "Cor da borda"

#: lib/bookshelf_settings.lua:2731
msgid "The frame around covers and the border of badges. Default black."
msgstr "O quadro ao redor das capas e a borda dos selos. Padrão preto."

#: lib/bookshelf_settings.lua:2736
msgid "Border color (% black)"
msgstr "Cor da borda (% preto)"

#: lib/bookshelf_settings.lua:2746 lib/bookshelf_settings.lua:2753
msgid "Selection outline color"
msgstr "Cor do contorno de seleção"

#: lib/bookshelf_settings.lua:2748
msgid "Color of the ring drawn around the selected book or the one you are currently reading. Default black."
msgstr "Cor do contorno desenhado ao redor do livro selecionado ou do que você está lendo. Preto por padrão."

#: lib/bookshelf_settings.lua:2753
msgid "Selection outline color (% black)"
msgstr "Cor do contorno de seleção (% de preto)"

#: lib/bookshelf_settings.lua:2763 lib/bookshelf_settings.lua:2771
msgid "Cover shadow color"
msgstr "Cor da sombra da capa"

#: lib/bookshelf_settings.lua:2765
msgid "Color of the drop shadow behind book covers and folder cards. Has no effect where the shadow is switched off. Default mid gray, and darker in night mode."
msgstr "Cor da sombra atrás das capas e dos cartões de pasta. Sem efeito quando a sombra está desligada. Cinza médio por padrão, mais escuro no modo noturno."

#: lib/bookshelf_settings.lua:2771
