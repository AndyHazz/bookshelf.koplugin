#: lib/bookshelf_settings.lua:2832
msgid "The thin line around each micro-module card. Left unset it follows the text color. Long-press to clear."
msgstr "A linha fina à volta de cada cartão de micro-módulo. Se ficar sem definir, segue a cor do texto. Mantenha pressionado para limpar."

