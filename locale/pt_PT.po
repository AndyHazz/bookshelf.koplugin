msgstr "Cor da borda"

#: lib/bookshelf_settings.lua:2850
msgid "The frame around covers and the border of badges. Default black."
msgstr "O quadro à volta das capas e a borda das marcas. Predefinição: preto."

#: lib/bookshelf_settings.lua:2855
msgid "Border color (% black)"
msgstr "Cor da borda (% preto)"

#: lib/bookshelf_settings.lua:2865 lib/bookshelf_settings.lua:2872
msgid "Selection outline color"
msgstr "Cor do contorno de seleção"

#: lib/bookshelf_settings.lua:2867
msgid "Color of the ring drawn around the selected book or the one you are currently reading. Default black."
msgstr "Cor do contorno desenhado à volta do livro selecionado ou do que está a ler. Preto por predefinição."

#: lib/bookshelf_settings.lua:2872
msgid "Selection outline color (% black)"
msgstr "Cor do contorno de seleção (% de preto)"

