msgstr "Pilha de livros"

#: lib/bookshelf_stack_display.lua:103
msgid "Collage"
msgstr "Colagem"

#: lib/bookshelf_stack_display.lua:104
msgid "Text"
msgstr "Texto"

#: lib/bookshelf_stack_display.lua:169
msgid "Default setting"
msgstr "Definição predefinida"

#: lib/bookshelf_start_menu_edit.lua:44 lib/bookshelf_start_menu_edit.lua:528
msgid "Divider"
msgstr "Divisor"

#: lib/bookshelf_start_menu_edit.lua:111
msgid "Choose an icon first to make this entry icon-only"
msgstr "Escolha primeiro um ícone para que esta entrada mostre apenas o ícone"

#: lib/bookshelf_start_menu_edit.lua:136
msgid "Dynamic icons aren't supported here"
msgstr "Ícones dinâmicos não são suportados aqui"

#: lib/bookshelf_start_menu_edit.lua:153
msgid "This entry is icon-only - add a label before removing the icon"
msgstr ""
"Esta entrada mostra apenas o ícone - adicione um rótulo antes de remover o "
"ícone"

#: lib/bookshelf_start_menu_edit.lua:172
msgid "Choose icon…"
