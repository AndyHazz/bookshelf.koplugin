msgstr "Cor da sombra da capa"

#: lib/bookshelf_settings.lua:2884
msgid "Color of the drop shadow behind book covers and folder cards. Has no effect where the shadow is switched off. Default mid gray, and darker in night mode."
msgstr "Cor da sombra atrás das capas e dos cartões de pasta. Sem efeito quando a sombra está desligada. Cinzento médio por predefinição, mais escuro no modo noturno."

#: lib/bookshelf_settings.lua:2890
msgid "Cover shadow color (% black)"
msgstr "Cor da sombra da capa (% de preto)"

#: lib/bookshelf_settings.lua:2901 lib/bookshelf_settings.lua:2906
