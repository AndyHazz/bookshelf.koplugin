msgid "Opened"
msgstr "Açılma"

#: lib/bookshelf_sort_engine.lua:687
msgid "Unread/Reading/Finished"
msgstr "Okunmamış/Okunuyor/Tamamlandı"

#: lib/bookshelf_sort_engine.lua:688
msgid "Unread 1st"
msgstr "Önce okunmamış"

#: lib/bookshelf_sort_engine.lua:697
