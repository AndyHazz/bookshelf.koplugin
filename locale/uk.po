#: lib/bookshelf_settings.lua:3519 lib/bookshelf_settings.lua:3546
#: lib/bookshelf_settings.lua:4797
msgid "Off"
msgstr "Вимкнено"

#: lib/bookshelf_settings.lua:1099
msgid "Folders only"
msgstr "Лише папки"

#: lib/bookshelf_settings.lua:1100
msgid "Groups only"
msgstr "Лише групи"

#: lib/bookshelf_settings.lua:1101
msgid "All stacks"
msgstr "Усі стеки"

#: lib/bookshelf_settings.lua:1116
msgid "Stack count badge"
msgstr "Значок кількості в стеку"

#: lib/bookshelf_settings.lua:1147
