msgstr "Перемістити до папки"

#: lib/bookshelf_start_menu_edit.lua:321 lib/bookshelf_start_menu_edit.lua:326
msgid "Library only"
msgstr "Лише бібліотека"

#: lib/bookshelf_start_menu_edit.lua:322 lib/bookshelf_start_menu_edit.lua:327
msgid "Reader only"
msgstr "Лише рідер"

#: lib/bookshelf_start_menu_edit.lua:323 lib/bookshelf_start_menu_edit.lua:325
msgid "Library and reader"
msgstr "Бібліотека й рідер"

