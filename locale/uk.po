msgstr "Затемнена обкладинка"

#: lib/bookshelf_settings.lua:943
msgid "Both"
msgstr "Обидва"

#: lib/bookshelf_settings.lua:948
msgid "Pause badge + faded cover"
msgstr "Значок паузи + затемнена обкладинка"

#: lib/bookshelf_settings.lua:963
msgid "On-hold display"
msgstr "Відображення відкладених"

#: lib/bookshelf_settings.lua:999
msgid "Within series folder"
msgstr "У межах папки серії"

#: lib/bookshelf_settings.lua:1000
msgid "Never"
msgstr "Ніколи"

#: lib/bookshelf_settings.lua:1015
msgid "Show series #"
msgstr "Показувати № серії"

#: lib/bookshelf_settings.lua:1033
msgid "Show favorites icon"
msgstr "Показувати іконку улюблених"

#: lib/bookshelf_settings.lua:1048
msgid "Star"
msgstr "Зірка"

#: lib/bookshelf_settings.lua:1062
msgid "Favorite icon"
msgstr "Іконка улюблених"

