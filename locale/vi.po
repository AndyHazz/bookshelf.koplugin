msgid "Border color"
msgstr "Màu viền"

#: lib/bookshelf_settings.lua:2440
msgid "Color of the book cover frame border + pill badge / page-count badge borders. Badge foreground is now just badge text. Default black."
msgstr "Màu viền khung bìa sách + viền pill badge / badge số trang. Màu chữ badge giờ chỉ là văn bản badge. Mặc định là màu đen."

#: lib/bookshelf_settings.lua:2446
msgid "Border color (% black)"
msgstr "Màu viền (% đen)"

#: lib/bookshelf_settings.lua:2456
msgid "Selection outline color"
msgstr "Màu viền vùng chọn"

#: lib/bookshelf_settings.lua:2458
msgid "Color of the ring drawn around the selected book or the one you are currently reading. Default black."
msgstr "Màu của viền vẽ quanh cuốn sách đang chọn hoặc cuốn bạn đang đọc. Mặc định là đen."

#: lib/bookshelf_settings.lua:2463
msgid "Selection outline color (% black)"
msgstr "Màu viền vùng chọn (% đen)"

#: lib/bookshelf_settings.lua:2473
msgid "Cover shadow color"
msgstr "Màu bóng đổ của bìa"

#: lib/bookshelf_settings.lua:2475
msgid "Color of the drop shadow behind book covers and folder cards. Has no effect where the shadow is switched off. Default mid gray, and darker in night mode."
msgstr "Màu của bóng đổ phía sau bìa sách và thẻ thư mục. Không có tác dụng khi bóng đổ đã tắt. Mặc định là xám vừa, tối hơn ở chế độ ban đêm."

#: lib/bookshelf_settings.lua:2481
msgid "Cover shadow color (% black)"
msgstr "Màu bóng đổ của bìa (% đen)"

#: lib/bookshelf_settings.lua:2491
msgid "Shelf plank color"
msgstr "Màu ván kệ"

#: lib/bookshelf_settings.lua:2493
msgid "Color of the shelf plank the Spines style stands its books on. The lit top surface and shaded front edge are both tinted from this one color. Default light oak."
msgstr "Màu của tấm ván kệ mà kiểu Gáy sách đặt sách lên. Cả mặt trên được chiếu sáng lẫn cạnh trước phủ bóng đều được tô từ cùng một màu này. Mặc định là màu gỗ sồi nhạt."

#: lib/bookshelf_settings.lua:2499
msgid "Shelf plank color (% black)"
msgstr "Màu ván kệ (% đen)"

#: lib/bookshelf_settings.lua:2510
msgid "Folder overlay background"
msgstr "Nền overlay thư mục"

#: lib/bookshelf_settings.lua:2515
